<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardGoalCompletion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="0dp"
    app:strokeColor="#360B41"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient2"
        android:orientation="vertical">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/button01"
            android:gravity="center_vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Goal Completion Overview"
                android:textColor="#8E24AA"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Horizontal Bar Chart -->

        <com.github.mikephil.charting.charts.HorizontalBarChart
            android:id="@+id/goalCompletionChart"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_margin="10dp" />

        <!-- Statistics -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtHighestGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 Highest Completion : Android App (92%)"
                android:textColor="#8E24AA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtLowestGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="⚠ Needs Attention : Java (54%)"
                android:textColor="#8E24AA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtAverageGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="📈 Average Completion : 76%"
                android:textColor="#8E24AA"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Goal Health -->

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>