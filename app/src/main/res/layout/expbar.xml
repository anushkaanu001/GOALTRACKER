<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardXPProgress"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="0dp"
    app:cardElevation="8dp"
    app:strokeColor="#8E24AA"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient2"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Heading -->

        <!-- Level -->

        <TextView
            android:id="@+id/txtLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Level 18"
            android:textColor="#8E24AA"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Progress Bar -->

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/xpProgress"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="5dp"
            android:indeterminate="false"
            android:max="6000"
            android:progress="4500"
            app:indicatorColor="#8E24AA"
            app:trackColor="#E8A2D9"
            app:trackCornerRadius="10dp"
            app:trackThickness="10dp" />

        <!-- XP Numbers -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtCurrentXP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4500 XP"
                android:textColor="#414141"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtNextLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6000 XP"
                android:textColor="#D793C6" />

        </LinearLayout>

        <!-- Remaining XP -->

        <TextView
            android:id="@+id/txtRemainingXP"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="1500 XP to Level 19"
            android:textColor="#8E24AA"
            android:textSize="13sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>